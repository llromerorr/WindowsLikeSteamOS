<Window x:Class="SteamOSConfigurator.VentanaRecuperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access"
        Left="0" Top="0"
        WindowStyle="None" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Opacity="0" IsHitTestVisible="False"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Iconos SVG estandarizados -->
        <Geometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z</Geometry>
        <Geometry x:Key="IconFPS">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</Geometry>
        <Geometry x:Key="IconPerf">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</Geometry>
        <Geometry x:Key="IconStretch">M4 6h16v12H4zm2 2v8h12V8z</Geometry>
        <Geometry x:Key="IconRefresh">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</Geometry>
        <Geometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
        <Geometry x:Key="IconPower">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z</Geometry>
        <Geometry x:Key="IconSleep">M12.3 2.31c-.96.4-1.83 1-2.5 1.77C8.12 5.76 7.42 8.35 8.16 11c.74 2.65 2.64 4.8 5.17 5.74 1.13.42 2.33.56 3.51.42-1.07 1.25-2.58 2.06-4.24 2.27-3.26.41-6.42-1.41-7.66-4.42C3.7 12 4.41 8.5 6.7 6.05c1.47-1.57 3.44-2.58 5.6-2.74z</Geometry>
        <Geometry x:Key="IconRam">M2 7h20v10H2V7zm2 2v6h16V9H4zm2 1h2v4H6v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4z</Geometry>
        <Geometry x:Key="IconDisplay">M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z</Geometry>
        <Geometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</Geometry>
        <Geometry x:Key="IconExit">M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</Geometry>
        <Geometry x:Key="IconSettings">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</Geometry>
        <Geometry x:Key="IconNetwork">M12 3C6.95 3 3.15 4.85 0 7.23L12 22 24 7.23C20.85 4.85 17.05 3 12 3zm0 2.22c3.96 0 7.37 1.49 10 3.51L12 18.27 2 8.73c2.63-2.02 6.04-3.51 10-3.51z</Geometry>
        <Geometry x:Key="IconController">M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5-.67 1.5-1.5-.67 1.5-1.5 1.5zm3-3c-.83 0-1.5-.67-1.5-1.5S17.67 9 18.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</Geometry>

        <!-- Botón Tab Lateral -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8F98A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/> <!-- No focus ring on tabs -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Estado activo lo manejaremos en CodeBehind con Foreground / Background -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón QAM General -->
        <Style x:Key="QamBtn" TargetType="Button">
            <Setter Property="Background" Value="#101824"/> <!-- Default un poco más oscuro -->
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="12,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#203248"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A3F5E"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#66C0F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A283B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Estilo SteamOS -->
        <Style x:Key="QamSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Foreground" Value="#66C0F4"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <!-- Simpler default style, can use built-in for now -->
        </Style>
    </Window.Resources>

    <Grid>
        <!-- AREA TRANSPARENTE: click aquí = cerrar -->
        <Border Background="#01000000" MouseLeftButtonDown="AreaTransparente_MouseDown"/>

        <!-- CAJÓN LATERAL DERECHO (Ancho ampliado para Tabs) -->
        <Border x:Name="CajonLateral" HorizontalAlignment="Right" Width="360" 
                BorderThickness="0" Margin="0,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CajonTranslate" X="360" />
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="#E60A0A0A"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <!-- CONTENIDO PRINCIPAL: Barra de Pestañas + Área Central -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/> <!-- Tab Bar -->
                    <ColumnDefinition Width="*"/> <!-- Main Panel -->
                </Grid.ColumnDefinitions>

                <!-- TAB BAR IZQUIERDA -->
                <Border Grid.Column="0" Background="#111111" BorderThickness="0,0,1,0" BorderBrush="#202A475E">
                    <StackPanel Margin="10,24,10,20">
                        <Button x:Name="btnTabConfig" Style="{StaticResource TabBtn}" Click="BtnTabConfig_Click" Background="#2A3F5E" Foreground="#FFFFFF">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnTabRed" Style="{StaticResource TabBtn}" Click="BtnTabRed_Click">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconNetwork}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnTabRendimiento" Style="{StaticResource TabBtn}" Click="BtnTabRendimiento_Click">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconPerf}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnTabMando" Style="{StaticResource TabBtn}" Click="BtnTabMando_Click">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconController}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnTabEnergia" Style="{StaticResource TabBtn}" Click="BtnTabEnergia_Click">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconPower}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ÁREA CENTRAL -->
                <Grid Grid.Column="1" Margin="20,24,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Tabs Content -->
                        <RowDefinition Height="Auto"/> <!-- Overlays -->
                    </Grid.RowDefinitions>

                    <!-- ═══ HEADER SIMPLIFICADO ═══ -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="borderGameIcon" CornerRadius="4" ClipToBounds="True" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Image x:Name="imgGameIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="lblHeaderTitle" Text="WindowsLikeSteamOS" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <DockPanel Margin="0,8,0,0">
                            <!-- Batería -->
                            <StackPanel x:Name="panelBateriaHeader" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="🔋 " FontSize="12" Foreground="#10B981" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblBateriaHeader" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Reloj -->
                            <TextBlock x:Name="lblHora" Text="12:00" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        
                        <Rectangle Height="1" Margin="0,14,0,0" Fill="#202A475E"/>
                    </StackPanel>

                    <!-- ═══ CONTENIDO DE LAS PESTAÑAS ═══ -->

                    <!-- PESTAÑA 1: CONFIGURACIÓN -->
                    <ScrollViewer x:Name="Grid_TabConfig" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="CONFIGURACIÓN RÁPIDA" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>
                            
                            <!-- VOLUMEN -->
                            <Button x:Name="btnVolumen" Style="{StaticResource QamBtn}" Click="BtnVolumen_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconVolume}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Volumen Principal" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblValVolumen" Grid.Column="2" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- SALIDA DE AUDIO 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎧" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Salida de Audio" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- BRILLO 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="☀️" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Brillo de Pantalla" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            
                            <!-- MODO NOCHE 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🌙" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Modo Noche (Filtro Azul)" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PESTAÑA 2: RED 🚧 -->
                    <ScrollViewer x:Name="Grid_TabRed" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="RED Y CONECTIVIDAD" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📶" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Wi-Fi" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ᛒ" FontSize="14" Foreground="#3B82F6" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Bluetooth" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✈️" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Modo Avión" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PESTAÑA 3: RENDIMIENTO -->
                    <ScrollViewer x:Name="Grid_TabRendimiento" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="RENDIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>
                            
                            <!-- NIVEL OSD -->
                            <Button x:Name="btnNivelOSD" Style="{StaticResource QamBtn}" Click="BtnNivelOSD_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconPerf}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Nivel OSD" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblValOSD" Grid.Column="2" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- MOTOR OSD -->
                            <Button x:Name="btnMotorOSD" Style="{StaticResource QamBtn}" Click="BtnMotorOSD_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconPerf}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Motor OSD" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblValMotorOSD" Grid.Column="2" Text="WPF" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- LIMITE FPS -->
                            <Button x:Name="btnLimiteFPS" Style="{StaticResource QamBtn}" Click="BtnLimiteFPS_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconFPS}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Límite de Fotogramas" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblValFPS" Grid.Column="2" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- REFRESH RATE 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconDisplay}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Frecuencia Pantalla (Hz)" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- TDP LIMIT 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔥" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Límite de TDP (Vatios)" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- GPU CLOCK 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Reloj Manual GPU" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>
                            <TextBlock Text="ESCALADO AVANZADO" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>

                            <!-- SCALING FILTER 🚧 -->
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔎" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Filtro de Escalado" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- GPU STRETCH (Mantiene funcionalidad pero muestra WIP icon per user feedback) -->
                            <Button x:Name="btnGpuStretch" Style="{StaticResource QamBtn}" Click="BtnGpuStretch_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconStretch}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Sincronización (Modo GPU)" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblValStretch" Grid.Column="2" Text="🚧" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- PESTAÑA 4: MANDO 🚧 -->
                    <ScrollViewer x:Name="Grid_TabMando" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="OPCIONES DE MANDO" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📳" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Vibración" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🕹️" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Probar Mando" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔌" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Apagar Mando" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource QamBtn}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎮" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Mapeo de Botones" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="🚧" FontSize="13" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PESTAÑA 5: ENERGÍA -->
                    <ScrollViewer x:Name="Grid_TabEnergia" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ENERGÍA Y SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#FF5252" Margin="6,4,0,6"/>
                            
                            <Button x:Name="btnSuspenderConsola" Style="{StaticResource QamBtn}" Click="BtnSuspenderConsola_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconSleep}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Suspender" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="btnHibernarConsola" Style="{StaticResource QamBtn}" Click="BtnHibernarConsola_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconSleep}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Hibernar" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="btnReiniciarConsola" Style="{StaticResource QamBtn}" Click="BtnReiniciarConsola_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#FF5252" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Reiniciar" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="btnApagarConsola" Style="{StaticResource QamBtn}" Click="BtnApagarConsola_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconPower}" Fill="#FF5252" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Apagar" FontSize="13" FontWeight="Bold" Foreground="#FF5252" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>
                            
                            <Button x:Name="btnModoEscritorio" Style="{StaticResource QamBtn}" Click="BtnModoEscritorio_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconExit}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Salir al Escritorio" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="btnCerrarSesion" Style="{StaticResource QamBtn}" Click="BtnCerrarSesion_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconLock}" Fill="#FFC107" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Cerrar Sesión Windows" FontSize="13" FontWeight="SemiBold" Foreground="#FFC107" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Liberar RAM lo movemos aquí o a rendimiento, lo pondremos en Rendimiento extra o aquí -->
                            <!-- Mantendremos Reiniciar Steam / Reinstalar aquí por limpieza -->
                            <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>
                            <TextBlock Text="MANTENIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>
                            <Button x:Name="btnReintentar" Style="{StaticResource QamBtn}" Click="BtnReintentar_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Reiniciar Steam" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="btnReinstalarSteam" Style="{StaticResource QamBtn}" Click="BtnReinstalarSteam_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                                        <Path Data="{StaticResource IconDownload}" Fill="#8F98A0" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Reinstalar Steam" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ OVERLAY DE CONFIRMACIÓN ═══ -->
                    <Grid x:Name="OverlayConfirmacion" Grid.RowSpan="3" Visibility="Collapsed" Background="#D9000000" Margin="-20,-24,-20,-20">
                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Background="#E60A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <Border Background="#1AFF5252" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconPower}" Fill="#FF5252" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="txtTituloConfirmacion" Text="¿Confirmar acción?" FontSize="15" FontWeight="Bold" Foreground="#F3F4F6" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtSubtituloConfirmacion" Text="Se cerrará cualquier juego." FontSize="11" Foreground="#9CA3AF" TextAlignment="Center" Margin="0,6,0,16" TextWrapping="Wrap"/>

                                <StackPanel Orientation="Vertical">
                                    <Button x:Name="btnConfirmarAccion" Style="{StaticResource QamBtn}" Click="BtnConfirmarAccion_Click" Height="36" Background="#FF5252" BorderThickness="0">
                                        <TextBlock Text="Aceptar" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="btnCancelarAccion" Style="{StaticResource QamBtn}" Click="BtnCancelarAccion_Click" Height="36" Margin="0,6,0,0">
                                        <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
