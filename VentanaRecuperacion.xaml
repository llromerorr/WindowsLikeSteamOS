<Window x:Class="SteamOSConfigurator.VentanaRecuperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLSteamOS Recovery" Height="720" Width="1280"
        WindowStyle="None" WindowState="Maximized" Topmost="True"
        Background="#080C14" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- ══ ICONOS VECTORIALES ══ -->
        <Geometry x:Key="IconRefresh">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</Geometry>
        <Geometry x:Key="IconCDN">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z</Geometry>
        <Geometry x:Key="IconDisplay">M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z</Geometry>
        <Geometry x:Key="IconLogs">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H7v-2h5v2zm5-4H7v-2h10v2zm0-4H7V7h10v2z</Geometry>
        <Geometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</Geometry>
        <Geometry x:Key="IconExit">M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</Geometry>

        <!-- ══ ESTILO TARJETA PRINCIPAL ══ -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8D6E5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Fondo con gradiente sutil -->
                            <Border x:Name="bgBorder" CornerRadius="14" Opacity="0.6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0F1923" Offset="0"/>
                                        <GradientStop Color="#131D2B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Borde fino -->
                            <Border x:Name="edgeBorder" CornerRadius="14" BorderThickness="1.5" BorderBrush="#1A2A3E"/>
                            <!-- Contenido -->
                            <Border CornerRadius="14" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0D2847" Offset="0"/>
                                            <GradientStop Color="#153A5E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#00AAFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#112E52" Offset="0"/>
                                            <GradientStop Color="#1A4268" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#00AAFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ ESTILO TARJETA CERRAR SESIÓN ══ -->
        <Style x:Key="CardButtonLogoff" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bgBorder" CornerRadius="14" Opacity="0.6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1F1508" Offset="0"/>
                                        <GradientStop Color="#2A1B0A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="edgeBorder" CornerRadius="14" BorderThickness="1.5" BorderBrush="#3D2A10"/>
                            <Border CornerRadius="14" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3A2508" Offset="0"/>
                                            <GradientStop Color="#4A3010" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#45300C" Offset="0"/>
                                            <GradientStop Color="#553A12" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ ESTILO TARJETA SALIR (ROJA) ══ -->
        <Style x:Key="CardButtonExit" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bgBorder" CornerRadius="14" Opacity="0.6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1F0C0E" Offset="0"/>
                                        <GradientStop Color="#2A1114" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="edgeBorder" CornerRadius="14" BorderThickness="1.5" BorderBrush="#3D1519"/>
                            <Border CornerRadius="14" Padding="16,0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3A1215" Offset="0"/>
                                            <GradientStop Color="#4E1A1F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#FF5252"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="bgBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#451619" Offset="0"/>
                                            <GradientStop Color="#5A1F24" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="edgeBorder" Property="BorderBrush" Value="#FF5252"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fondo con doble gradiente radial para profundidad -->
        <Grid.Background>
            <RadialGradientBrush Center="0.3,0.1" GradientOrigin="0.3,0.1" RadiusX="1.2" RadiusY="1.0">
                <GradientStop Color="#0E1E35" Offset="0.0"/>
                <GradientStop Color="#080C14" Offset="0.8"/>
            </RadialGradientBrush>
        </Grid.Background>
        <!-- Segundo gradiente decorativo -->
        <Border Opacity="0.35">
            <Border.Background>
                <RadialGradientBrush Center="0.85,0.9" GradientOrigin="0.85,0.9" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#1A0A30" Offset="0.0"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="60,28,60,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ CABECERA ══ -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo circular con brillo -->
                    <Grid Width="56" Height="56" Margin="0,0,18,0">
                        <Ellipse Fill="#0A1628" Stroke="#00AAFF" StrokeThickness="2"/>
                        <TextBlock Text="WL" FontSize="20" FontWeight="Black" Foreground="#00CCFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WLSteamOS" FontSize="28" FontWeight="Black" Foreground="#00CCFF"/>
                            <TextBlock Text="  Recovery" FontSize="28" FontWeight="Light" Foreground="#FFFFFF" Opacity="0.85"/>
                        </StackPanel>
                        <TextBlock x:Name="lblEstadoSubtitulo" Text="Se ha pausado la sesión. Selecciona una acción con el mando o teclado." FontSize="13" Foreground="#6B8EAD" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Indicador de estado -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="20" Padding="14,7"
                        Background="#0C1622" BorderBrush="#1A3050" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="dotEstado" Width="8" Height="8" Fill="#00E676" Margin="0,0,10,0"/>
                        <TextBlock x:Name="lblEstadoConexion" Text="MANDO CONECTADO" FontSize="11" FontWeight="Bold" Foreground="#8FAFC8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ CONTENIDO CENTRAL ══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="530"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── TARJETAS ── -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    
                    <!-- 1. Reintentar Steam -->
                    <Button x:Name="btnReintentar" Style="{StaticResource CardButton}" Click="BtnReintentar_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D3A6E" Offset="0"/>
                                            <GradientStop Color="#0A2648" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconRefresh}" Fill="#4FC3F7" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Reintentar lanzamiento de Steam" FontSize="15" FontWeight="Bold" Foreground="#E8F0FE"/>
                                <TextBlock Text="Limpia la memoria y vuelve a abrir Steam Big Picture" FontSize="11.5" Foreground="#6B8EAD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 2. Reparar CDN -->
                    <Button x:Name="btnRepararCDN" Style="{StaticResource CardButton}" Click="BtnRepararCDN_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D4A30" Offset="0"/>
                                            <GradientStop Color="#083820" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconCDN}" Fill="#66BB6A" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Reinstalar / Reparar Steam (CDN Valve)" FontSize="15" FontWeight="Bold" Foreground="#E8F0FE"/>
                                <TextBlock Text="Descarga silenciosa de la última versión oficial" FontSize="11.5" Foreground="#6B8EAD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 3. Restaurar Pantallas -->
                    <Button x:Name="btnRestaurarPantalla" Style="{StaticResource CardButton}" Click="BtnRestaurarPantalla_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4A3800" Offset="0"/>
                                            <GradientStop Color="#352800" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconDisplay}" Fill="#FFCA28" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Restaurar Pantallas y Resoluciones" FontSize="15" FontWeight="Bold" Foreground="#E8F0FE"/>
                                <TextBlock Text="Restablece topología visual y Hz por defecto" FontSize="11.5" Foreground="#6B8EAD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 4. Ver Logs -->
                    <Button x:Name="btnVerLogs" Style="{StaticResource CardButton}" Click="BtnVerLogs_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2E1565" Offset="0"/>
                                            <GradientStop Color="#1A0D40" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconLogs}" Fill="#CE93D8" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Ver Registro de Errores" FontSize="15" FontWeight="Bold" Foreground="#E8F0FE"/>
                                <TextBlock Text="Consulta diagnósticos detallados del sistema" FontSize="11.5" Foreground="#6B8EAD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Separador sutil -->
                    <Border Height="1" Margin="10,6,10,8" Opacity="0.25" Background="#2A4060"/>

                    <!-- 5. Cerrar Sesión -->
                    <Button x:Name="btnCerrarSesion" Style="{StaticResource CardButtonLogoff}" Click="BtnCerrarSesion_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A3D00" Offset="0"/>
                                            <GradientStop Color="#3D2900" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconLock}" Fill="#FFD54F" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Cerrar Sesión de Windows" FontSize="15" FontWeight="Bold" Foreground="#FFE082"/>
                                <TextBlock Text="Regresa a la pantalla de usuarios de Windows" FontSize="11.5" Foreground="#B8924A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 6. Modo Escritorio -->
                    <Button x:Name="btnModoEscritorio" Style="{StaticResource CardButtonExit}" Click="BtnModoEscritorio_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A1520" Offset="0"/>
                                            <GradientStop Color="#3D0E15" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="{StaticResource IconExit}" Fill="#EF5350" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Cargar Escritorio de Windows" FontSize="15" FontWeight="Bold" Foreground="#EF9A9A"/>
                                <TextBlock Text="Cierra Steam y carga explorer.exe" FontSize="11.5" Foreground="#A05A5A" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- ── TERMINAL DE LOGS ── -->
                <Border Grid.Column="1" CornerRadius="14" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#060910" Offset="0"/>
                            <GradientStop Color="#080D16" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A2D45" Offset="0"/>
                            <GradientStop Color="#101A28" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1.5</Thickness>
                    </Border.BorderThickness>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera del terminal -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#FF5F56" Margin="0,0,5,0"/>
                                <Ellipse Width="8" Height="8" Fill="#FFBD2E" Margin="0,0,5,0"/>
                                <Ellipse Width="8" Height="8" Fill="#27C93F" Margin="0,0,14,0"/>
                                <TextBlock Text="SYSTEM TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="#4A6A85"/>
                            </StackPanel>
                            <TextBlock x:Name="lblUltimaActualizacion" Text="Actualizado" FontSize="10" Foreground="#3A5068" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer x:Name="scrollLogs" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtLogs" Background="Transparent" Foreground="#6B8EAD" BorderThickness="0" 
                                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap"
                                     AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ BARRA INFERIOR ══ -->
            <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#152030" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Background="#00AAFF" CornerRadius="4" Width="24" Height="24" Margin="0,0,8,0">
                            <TextBlock Text="A" FontSize="13" FontWeight="Black" Foreground="#080C14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SELECCIONAR" FontSize="11" FontWeight="Bold" Foreground="#8FAFC8" VerticalAlignment="Center" Margin="0,0,28,0"/>

                        <Border Background="#FF5252" CornerRadius="4" Width="24" Height="24" Margin="0,0,8,0">
                            <TextBlock Text="B" FontSize="13" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ESCRITORIO" FontSize="11" FontWeight="Bold" Foreground="#8FAFC8" VerticalAlignment="Center" Margin="0,0,28,0"/>

                        <Border Background="#152030" CornerRadius="4" Padding="10,4" Margin="0,0,8,0" BorderBrush="#253848" BorderThickness="1">
                            <TextBlock Text="D-PAD" FontSize="10" FontWeight="Black" Foreground="#4FC3F7"/>
                        </Border>
                        <TextBlock Text="NAVEGAR" FontSize="11" FontWeight="Bold" Foreground="#8FAFC8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="WLSteamOS v4.0" FontSize="11" FontWeight="Bold" Foreground="#253848" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
