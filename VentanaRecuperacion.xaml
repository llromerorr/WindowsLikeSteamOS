<Window x:Class="SteamOSConfigurator.VentanaRecuperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access"
        Left="0" Top="0"
        WindowStyle="None" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Opacity="0" IsHitTestVisible="False"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Iconos SVG estandarizados -->
        <Geometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z</Geometry>
        <Geometry x:Key="IconFPS">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</Geometry>
        <Geometry x:Key="IconPerf">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</Geometry>
        <Geometry x:Key="IconStretch">M4 6h16v12H4zm2 2v8h12V8z</Geometry>
        <Geometry x:Key="IconRefresh">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</Geometry>
        <Geometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
        <Geometry x:Key="IconPower">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z</Geometry>
        <Geometry x:Key="IconSleep">M12.3 2.31c-.96.4-1.83 1-2.5 1.77C8.12 5.76 7.42 8.35 8.16 11c.74 2.65 2.64 4.8 5.17 5.74 1.13.42 2.33.56 3.51.42-1.07 1.25-2.58 2.06-4.24 2.27-3.26.41-6.42-1.41-7.66-4.42C3.7 12 4.41 8.5 6.7 6.05c1.47-1.57 3.44-2.58 5.6-2.74z</Geometry>
        <Geometry x:Key="IconRam">M2 7h20v10H2V7zm2 2v6h16V9H4zm2 1h2v4H6v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4z</Geometry>
        <Geometry x:Key="IconDisplay">M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z</Geometry>
        <Geometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</Geometry>
        <Geometry x:Key="IconExit">M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</Geometry>

        <!-- Botón QAM: Estilo Microsoft Game Bar / Gamescope (Compacto para Consolas Portátiles) -->
        <Style x:Key="QamBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="10,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- AREA TRANSPARENTE: click aquí = cerrar -->
        <Border Background="#01000000" MouseLeftButtonDown="AreaTransparente_MouseDown"/>

        <!-- CAJÓN LATERAL DERECHO (Estilo Game Bar / Gamescope) -->
        <Border x:Name="CajonLateral" HorizontalAlignment="Right" Width="310" 
                BorderBrush="#25FFFFFF" BorderThickness="1,0,0,0"
                Margin="0,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CajonTranslate" X="310" />
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="#F0181818"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ HEADER (DASHBOARD) ═══ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quick Access" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblHora" Grid.Column="1" Text="12:00" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ROW 0: CPU & RAM -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="CPU" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="30"/>
                                <TextBlock x:Name="lblCPU" Text="0%" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblCPUTemp" Text="--°C" FontSize="11" Foreground="#FFB74D" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar x:Name="barCPU" Height="4" Value="0" Maximum="100" Background="#20FFFFFF" Foreground="#4FC3F7" BorderThickness="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="RAM" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="30"/>
                                <TextBlock x:Name="lblRAM" Text="0%" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar x:Name="barRAM" Height="4" Value="0" Maximum="100" Background="#20FFFFFF" Foreground="#CE93D8" BorderThickness="0"/>
                        </StackPanel>

                        <!-- ROW 2: GPU & DISK -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="GPU" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="30"/>
                                <TextBlock x:Name="lblGPU" Text="0%" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblGPUTemp" Text="--°C" FontSize="11" Foreground="#FFB74D" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar x:Name="barGPU" Height="4" Value="0" Maximum="100" Background="#20FFFFFF" Foreground="#81C784" BorderThickness="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="DISK" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="30"/>
                                <TextBlock x:Name="lblDisk" Text="0%" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </StackPanel>
                            <ProgressBar x:Name="barDisk" Height="4" Value="0" Maximum="100" Background="#20FFFFFF" Foreground="#FF8A65" BorderThickness="0"/>
                        </StackPanel>

                        <!-- ROW 4: NET & BATTERY -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="NET" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="30"/>
                                <TextBlock x:Name="lblNet" Text="0 KB/s" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="panelBateria" Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="BATT" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold" Width="35"/>
                            <TextBlock x:Name="lblBateria" Text="100%" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Margin="0,15,0,0" Fill="#20FFFFFF"/>
                </StackPanel>

                <!-- ═══ ITEMS ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>

                        <!-- SECCIÓN: AJUSTES RÁPIDOS -->
                        <TextBlock Text="AJUSTES RÁPIDOS" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" Margin="6,4,0,4"/>

                        <!-- VOLUMEN -->
                        <Button x:Name="btnVolumen" Style="{StaticResource QamBtn}" Click="BtnVolumen_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconVolume}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Volumen" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValVolumen" Grid.Column="2" Text="85%" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- FPS -->
                        <Button x:Name="btnLimiteFPS" Style="{StaticResource QamBtn}" Click="BtnLimiteFPS_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconFPS}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Límite FPS" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValFPS" Grid.Column="2" Text="60" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- OVERLAY -->
                        <Button x:Name="btnNivelOSD" Style="{StaticResource QamBtn}" Click="BtnNivelOSD_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconPerf}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Capa de Rendimiento" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValOSD" Grid.Column="2" Text="Desactivado" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- GPU STRETCH -->
                        <Button x:Name="btnGpuStretch" Style="{StaticResource QamBtn}" Click="BtnGpuStretch_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconStretch}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Escalado GPU" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValStretch" Grid.Column="2" Text="Activado" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- LIBERAR MEMORIA RAM -->
                        <Button x:Name="btnLiberarRAM" Style="{StaticResource QamBtn}" Click="BtnLiberarRAM_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconRam}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock x:Name="txtLiberarRAM" Grid.Column="1" Text="Liberar Memoria RAM" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="4,10" Fill="#20FFFFFF"/>

                        <!-- SECCIÓN: MANTENIMIENTO -->
                        <TextBlock Text="MANTENIMIENTO" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" Margin="6,4,0,4"/>

                        <!-- REINICIAR -->
                        <Button x:Name="btnReintentar" Style="{StaticResource QamBtn}" Click="BtnReintentar_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconRefresh}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock x:Name="txtReintentar" Grid.Column="1" Text="Reiniciar Steam" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- REINSTALAR STEAM -->
                        <Button x:Name="btnReinstalarSteam" Style="{StaticResource QamBtn}" Click="BtnReinstalarSteam_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconDownload}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock x:Name="txtReinstalarSteam" Grid.Column="1" Text="Reinstalar Steam" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- RESTAURAR -->
                        <Button x:Name="btnRestaurarPantalla" Style="{StaticResource QamBtn}" Click="BtnRestaurarPantalla_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconDisplay}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Restaurar Pantalla" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="4,10" Fill="#20FFFFFF"/>

                        <!-- SECCIÓN: OPCIONES DE ENERGÍA -->
                        <TextBlock Text="OPCIONES DE ENERGÍA" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" Margin="6,4,0,4"/>

                        <!-- SUSPENDER CONSOLA -->
                        <Button x:Name="btnSuspenderConsola" Style="{StaticResource QamBtn}" Click="BtnSuspenderConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconSleep}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Suspender Consola" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- HIBERNAR CONSOLA -->
                        <Button x:Name="btnHibernarConsola" Style="{StaticResource QamBtn}" Click="BtnHibernarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconSleep}" Fill="#60A5FA" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Hibernar Consola" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- CERRAR SESION DE WINDOWS (AMARILLO) -->
                        <Button x:Name="btnCerrarSesion" Style="{StaticResource QamBtn}" Click="BtnCerrarSesion_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconLock}" Fill="#FFC107" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Cerrar Sesión de Windows" FontSize="13" FontWeight="SemiBold" Foreground="#FFC107" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- REINICIAR CONSOLA -->
                        <Button x:Name="btnReiniciarConsola" Style="{StaticResource QamBtn}" Click="BtnReiniciarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconRefresh}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Reiniciar Consola" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- APAGAR CONSOLA (ROJO) -->
                        <Button x:Name="btnApagarConsola" Style="{StaticResource QamBtn}" Click="BtnApagarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconPower}" Fill="#FF6B6B" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Apagar Consola" FontSize="13" FontWeight="SemiBold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="4,10" Fill="#20FFFFFF"/>

                        <!-- SECCIÓN: SALIDA -->
                        <TextBlock Text="SALIDA" FontSize="10" FontWeight="Bold" Foreground="#80FFFFFF" Margin="6,4,0,4"/>

                        <!-- ESCRITORIO -->
                        <Button x:Name="btnModoEscritorio" Style="{StaticResource QamBtn}" Click="BtnModoEscritorio_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconExit}" Fill="#D0D0D0" Stretch="Uniform"/></Viewbox>
                                <TextBlock Grid.Column="1" Text="Salir al Escritorio" FontSize="13" FontWeight="Normal" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ OVERLAY DE CONFIRMACIÓN (CONSOLA) ═══ -->
                <Grid x:Name="OverlayConfirmacion" Grid.RowSpan="3" Visibility="Collapsed" Background="#F0121212" Margin="-20,-24,-20,-20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="25,0">
                        <Viewbox Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="{StaticResource IconPower}" Fill="#FFC107" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="txtTituloConfirmacion" Text="¿Confirmar acción?" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtSubtituloConfirmacion" Text="Se cerrará cualquier juego sin guardar." FontSize="12" Foreground="#A0A0A0" TextAlignment="Center" Margin="0,8,0,24" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Vertical">
                            <Button x:Name="btnConfirmarAccion" Style="{StaticResource QamBtn}" Click="BtnConfirmarAccion_Click" Height="44">
                                <TextBlock Text="Sí, Confirmar" FontSize="14" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                            </Button>
                            <Button x:Name="btnCancelarAccion" Style="{StaticResource QamBtn}" Click="BtnCancelarAccion_Click" Height="44" Margin="0,8,0,0">
                                <TextBlock Text="Cancelar" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
