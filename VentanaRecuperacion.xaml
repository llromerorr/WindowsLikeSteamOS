<Window x:Class="SteamOSConfigurator.VentanaRecuperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Access"
        Left="0" Top="0"
        WindowStyle="None" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Opacity="0" IsHitTestVisible="False"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Iconos SVG estandarizados -->
        <Geometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z</Geometry>
        <Geometry x:Key="IconFPS">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</Geometry>
        <Geometry x:Key="IconPerf">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</Geometry>
        <Geometry x:Key="IconStretch">M4 6h16v12H4zm2 2v8h12V8z</Geometry>
        <Geometry x:Key="IconRefresh">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</Geometry>
        <Geometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
        <Geometry x:Key="IconPower">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z</Geometry>
        <Geometry x:Key="IconSleep">M12.3 2.31c-.96.4-1.83 1-2.5 1.77C8.12 5.76 7.42 8.35 8.16 11c.74 2.65 2.64 4.8 5.17 5.74 1.13.42 2.33.56 3.51.42-1.07 1.25-2.58 2.06-4.24 2.27-3.26.41-6.42-1.41-7.66-4.42C3.7 12 4.41 8.5 6.7 6.05c1.47-1.57 3.44-2.58 5.6-2.74z</Geometry>
        <Geometry x:Key="IconRam">M2 7h20v10H2V7zm2 2v6h16V9H4zm2 1h2v4H6v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4z</Geometry>
        <Geometry x:Key="IconDisplay">M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z</Geometry>
        <Geometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</Geometry>
        <Geometry x:Key="IconExit">M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</Geometry>

        <!-- Botón QAM: Estilo Native Steam Deck (Pill sin bordes duros) -->
        <Style x:Key="QamBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7D5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="12,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#203248"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A3F5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A283B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- AREA TRANSPARENTE: click aquí = cerrar -->
        <Border Background="#01000000" MouseLeftButtonDown="AreaTransparente_MouseDown"/>

        <!-- CAJÓN LATERAL DERECHO (Estilo Native Steam Deck QAM) -->
        <Border x:Name="CajonLateral" HorizontalAlignment="Right" Width="310" 
                BorderThickness="0" Margin="0,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CajonTranslate" X="310" />
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="#F6171A21"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
            </Border.Effect>

            <Grid Margin="20,24,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ HEADER (DASHBOARD SIMÉTRICO) ═══ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quick Access" FontSize="18" FontWeight="Bold" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblHora" Grid.Column="1" Text="12:00" FontSize="18" FontWeight="Bold" Foreground="#1A9FFF" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- TABLA SIMÉTRICA DE HARDWARE -->
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA 0: CPU -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CPU" FontSize="11" Foreground="#8F98A0" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="lblCPUTemp" Text="--°C" FontSize="10" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="lblCPU" Text="0%" FontSize="11" Foreground="#F3F3F3" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="barCPU" Height="4" Background="#1E2838" Foreground="#1A9FFF" Minimum="0" Maximum="100"/>
                        </StackPanel>

                        <!-- COLUMNA 1: GPU -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GPU" FontSize="11" Foreground="#8F98A0" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="lblGPUTemp" Text="--°C" FontSize="10" Foreground="#66C0F4" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="lblGPU" Text="0%" FontSize="11" Foreground="#F3F3F3" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="barGPU" Height="4" Background="#1E2838" Foreground="#1A9FFF" Minimum="0" Maximum="100"/>
                        </StackPanel>

                        <!-- COLUMNA 0: RAM -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="RAM" FontSize="11" Foreground="#8F98A0" FontWeight="Bold"/>
                                <TextBlock x:Name="lblRAM" Text="0%" FontSize="11" Foreground="#F3F3F3" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="barRAM" Height="4" Background="#1E2838" Foreground="#66C0F4" Minimum="0" Maximum="100"/>
                        </StackPanel>

                        <!-- COLUMNA 1: BATERÍA / ALIMENTACIÓN (Solo si existe batería) -->
                        <StackPanel x:Name="panelBateria" Grid.Row="2" Grid.Column="2" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="BATERÍA" FontSize="11" Foreground="#8F98A0" FontWeight="Bold"/>
                                <TextBlock x:Name="lblBateria" Text="100%" FontSize="11" Foreground="#F3F3F3" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="barBateria" Height="4" Background="#1E2838" Foreground="#00FF88" Minimum="0" Maximum="100" Value="100"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Margin="0,14,0,0" Fill="#202A475E"/>
                </StackPanel>

                <!-- ═══ ITEMS ═══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>

                        <!-- SECCIÓN: AJUSTES RÁPIDOS -->
                        <TextBlock Text="AJUSTES RÁPIDOS" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>

                        <!-- VOLUMEN -->
                        <Button x:Name="btnVolumen" Style="{StaticResource QamBtn}" Click="BtnVolumen_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconVolume}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Volumen Principal" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValVolumen" Grid.Column="2" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- LÍMITE FPS -->
                        <Button x:Name="btnLimiteFPS" Style="{StaticResource QamBtn}" Click="BtnLimiteFPS_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconFPS}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Límite de Fotogramas" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValFPS" Grid.Column="2" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- NIVER OSD -->
                        <Button x:Name="btnNivelOSD" Style="{StaticResource QamBtn}" Click="BtnNivelOSD_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconPerf}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Nivel Rendimiento OSD" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValOSD" Grid.Column="2" Text="OFF" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- GPU STRETCH -->
                        <Button x:Name="btnGpuStretch" Style="{StaticResource QamBtn}" Click="BtnGpuStretch_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconStretch}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Escalado GPU Pantalla" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValStretch" Grid.Column="2" Text="ON" FontSize="13" FontWeight="SemiBold" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- LIBERAR RAM -->
                        <Button x:Name="btnLiberarRAM" Style="{StaticResource QamBtn}" Click="BtnLiberarRAM_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconRam}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Liberar Memoria RAM" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblValRAM" Grid.Column="2" Text="Limpiar" FontSize="12" Foreground="#8F98A0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>

                        <!-- SECCIÓN: MANTENIMIENTO -->
                        <TextBlock Text="MANTENIMIENTO" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>

                        <!-- REINICIAR STEAM -->
                        <Button x:Name="btnReintentar" Style="{StaticResource QamBtn}" Click="BtnReintentar_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Reiniciar Steam" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblEstadoReiniciarSteam" Grid.Column="2" Text="" FontSize="11" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- REINSTALAR STEAM -->
                        <Button x:Name="btnReinstalarSteam" Style="{StaticResource QamBtn}" Click="BtnReinstalarSteam_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconDownload}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Reinstalar Steam" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblEstadoReinstalar" Grid.Column="2" Text="" FontSize="11" Foreground="#66C0F4" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- RESTAURAR PANTALLA -->
                        <Button x:Name="btnRestaurarPantalla" Style="{StaticResource QamBtn}" Click="BtnRestaurarPantalla_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconDisplay}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Restaurar Pantalla" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>

                        <!-- SECCIÓN: OPCIONES DE ENERGÍA -->
                        <TextBlock Text="OPCIONES DE ENERGÍA" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>

                        <!-- SUSPENDER -->
                        <Button x:Name="btnSuspenderConsola" Style="{StaticResource QamBtn}" Click="BtnSuspenderConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconSleep}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Suspender Consola" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- HIBERNAR CONSOLA -->
                        <Button x:Name="btnHibernarConsola" Style="{StaticResource QamBtn}" Click="BtnHibernarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconSleep}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Hibernar Consola" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- CERRAR SESIÓN WINDOWS -->
                        <Button x:Name="btnCerrarSesion" Style="{StaticResource QamBtn}" Click="BtnCerrarSesion_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconLock}" Fill="#FFC107" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Cerrar Sesión Windows" FontSize="13" FontWeight="SemiBold" Foreground="#FFC107" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- REINICIAR CONSOLA -->
                        <Button x:Name="btnReiniciarConsola" Style="{StaticResource QamBtn}" Click="BtnReiniciarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#FF5252" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Reiniciar Consola" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- APAGAR CONSOLA -->
                        <Button x:Name="btnApagarConsola" Style="{StaticResource QamBtn}" Click="BtnApagarConsola_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconPower}" Fill="#FF5252" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Apagar Consola" FontSize="13" FontWeight="Bold" Foreground="#FF5252" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Rectangle Height="1" Margin="0,10,0,10" Fill="#2A475E"/>

                        <!-- SECCIÓN: SALIDA -->
                        <TextBlock Text="SALIDA" FontSize="11" FontWeight="Bold" Foreground="#66C0F4" Margin="6,4,0,6"/>

                        <!-- MODO ESCRITORIO -->
                        <Button x:Name="btnModoEscritorio" Style="{StaticResource QamBtn}" Click="BtnModoEscritorio_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconExit}" Fill="#8F98A0" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Salir al Escritorio" FontSize="13" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ OVERLAY DE CONFIRMACIÓN (ESTILO STEAM MODAL) ═══ -->
                <Grid x:Name="OverlayConfirmacion" Grid.RowSpan="3" Visibility="Collapsed" Background="#FA171A21" Margin="-20,-24,-20,-20">
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="260" Background="#1E2838" BorderBrush="#2A475E" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <Viewbox Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconPower}" Fill="#1A9FFF" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock x:Name="txtTituloConfirmacion" Text="¿Confirmar acción?" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtSubtituloConfirmacion" Text="Se cerrará cualquier juego sin guardar." FontSize="12" Foreground="#8F98A0" TextAlignment="Center" Margin="0,8,0,20" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Vertical">
                                <Button x:Name="btnConfirmarAccion" Style="{StaticResource QamBtn}" Click="BtnConfirmarAccion_Click" Height="40">
                                    <TextBlock Text="Aceptar" FontSize="14" FontWeight="Bold" Foreground="#1A9FFF" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="btnCancelarAccion" Style="{StaticResource QamBtn}" Click="BtnCancelarAccion_Click" Height="40" Margin="0,6,0,0">
                                    <TextBlock Text="Cancelar" FontSize="13" FontWeight="SemiBold" Foreground="#C7D5E0" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
