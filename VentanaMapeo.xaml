<ui:FluentWindow x:Class="SteamOSConfigurator.VentanaMapeo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SteamOS - Configurar Mando" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SteamOS - Configurar Mando"/>

        <Grid Grid.Row="1" Margin="30, 15, 30, 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <ui:TextBlock Text="Mapeo de Mando" FontTypography="Title" FontWeight="Black" />
                <ui:TextBlock x:Name="lblSubtitulo" Text="Detectando dispositivo..." FontTypography="Caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0"/>
                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,15,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:TextBlock x:Name="lblEmoji" Text="🎮" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <ui:TextBlock x:Name="lblInstruccion" Text="Buscando mando..." FontTypography="Subtitle" HorizontalAlignment="Center"/>
                <ui:TextBlock x:Name="lblDetalle" Text="Asegúrate de que esté conectado al USB" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <ui:Button x:Name="btnCancelar" Grid.Row="2" Content="CANCELAR MAPEO" Appearance="Danger" HorizontalAlignment="Stretch" Click="BtnCancelar_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
