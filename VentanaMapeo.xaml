<Window x:Class="SteamOSConfigurator.VentanaMapeo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Mando" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#121318" FontFamily="Segoe UI" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E54D5D"/>
            <Setter Property="BorderBrush" Value="#E54D5D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D1619"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Mapeo de Mando" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
            <TextBlock x:Name="lblSubtitulo" Text="Detectando dispositivo..." FontSize="11" Foreground="#1068E5" FontWeight="Bold" Margin="0,2,0,0"/>
            <Border Height="1" Background="#2A2D38" Margin="0,15,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="lblEmoji" Text="🎮" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock x:Name="lblInstruccion" Text="Buscando mando..." FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="lblDetalle" Text="Asegúrate de que esté conectado al USB" FontSize="13" Foreground="#707A8C" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <Button x:Name="btnCancelar" Grid.Row="2" Content="CANCELAR MAPEO" Style="{StaticResource SecondaryButton}" Click="BtnCancelar_Click"/>
    </Grid>
</Window>