<Window x:Class="SteamOSConfigurator.VentanaHUD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Overlay"
        Left="16" Top="16" Width="Auto" Height="Auto"
        WindowStyle="None" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="False" Opacity="0"
        FontFamily="Segoe UI">

    <!-- Design System: 4 Dynamic OSD Levels (Modular Capsules & Neon Styling) -->
    <StackPanel x:Name="PanelContenido" Orientation="Vertical">

        <!-- CÁPSULA 1: FPS & Hora (NIVEL 1+) -->
        <Border x:Name="FilaFPS" Background="#E60A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M21,3H3C1.89,3 1,3.89 1,5V17A2,2 0 0,0 3,19H8V21H16V19H21A2,2 0 0,0 23,17V5C23,3.89 22.1,3 21,3M21,17H3V5H21V17Z" Fill="#10B981" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblFPS" Text="60" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                    <TextBlock Text=" FPS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <Border x:Name="borderGameIcon" CornerRadius="4" ClipToBounds="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed">
                        <Image x:Name="imgGameIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="lblGameName" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                
                <TextBlock x:Name="lblHoraHUD" Grid.Column="2" Text="12:00" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- CÁPSULA 2: Gráfica Frametime & Res (NIVEL 2+) -->
        <Border x:Name="FilaGrafica" Background="#E60A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Polyline Graph -->
                <Border Width="120" Height="22" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" VerticalAlignment="Center" ClipToBounds="True">
                    <Polyline x:Name="graphFPS" Stroke="#10B981" StrokeThickness="1.5" Points="0,22 120,22"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="lblFrametimeMs" Text="16.6 ms" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblResolution" Text="1920x1080" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CÁPSULA 3: GPU & VRAM (NIVEL 3+) -->
        <Border x:Name="FilaGPU" Background="#E60A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Icon -->
                <Border Grid.RowSpan="2" Background="#1A8B5CF6" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="M21 2H3C1.9 2 1 2.9 1 4V14C1 15.1 1.9 16 3 16H8V20H10V18H14V20H16V18H21C22.1 18 23 17.1 23 16V4C23 2.9 22.1 2 21 2ZM21 16H3V4H21V16ZM6 6H13V10H6V6ZM15 6H18V10H15V6Z" Fill="#8B5CF6" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- GPU Core -->
                <TextBlock Grid.Column="1" Text="GPU" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblGPU" Grid.Column="1" Grid.Row="1" Text="0%" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="2" Text="TEMP" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblGPUTemp" Grid.Column="2" Grid.Row="1" Text="--°C" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#D1D5DB" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="3" Text="CLOCK" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblGPUClock" Grid.Column="3" Grid.Row="1" Text="-- MHz" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="4" Text="POWER" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblGPUPower" Grid.Column="4" Grid.Row="1" Text="--W" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Top"/>

                <!-- VRAM -->
                <StackPanel Grid.Column="5" Grid.RowSpan="2" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="VRAM" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblVRAMUsed" Text="-- GB" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- FAN GPU -->
                <StackPanel x:Name="panelGPUFan" Grid.Column="6" Grid.RowSpan="2" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="FAN" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblGPUFan" Text="-- RPM" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- GPU NAME -->
                <TextBlock x:Name="lblGPUName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
            </Grid>
        </Border>

        <!-- CÁPSULA 4: CPU & RAM (NIVEL 3+) -->
        <Border x:Name="FilaCPU" Background="#E60A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Icon -->
                <Border Grid.RowSpan="2" Background="#1A3B82F6" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="M7,4V2H9V4H11V2H13V4H15V2H17V4A2,2 0 0,1 19,6V8H21V10H19V12H21V14H19V16H21V18H19A2,2 0 0,1 17,20V22H15V20H13V22H11V20H9V22H7V20A2,2 0 0,1 5,18H3V16H5V14H3V12H5V10H3V8H5A2,2 0 0,1 7,4M7,6V18H17V6H7M9,8H15V14H9V8Z" Fill="#3B82F6" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- CPU Core -->
                <TextBlock Grid.Column="1" Text="CPU" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblCPU" Grid.Column="1" Grid.Row="1" Text="0%" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="2" Text="TEMP" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblCPUTemp" Grid.Column="2" Grid.Row="1" Text="--°C" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#D1D5DB" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="3" Text="CLOCK" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblCPUClock" Grid.Column="3" Grid.Row="1" Text="-- MHz" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Top"/>

                <TextBlock Grid.Column="4" Text="POWER" FontSize="9" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="lblCPUPower" Grid.Column="4" Grid.Row="1" Text="--W" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Top"/>

                <!-- RAM -->
                <StackPanel Grid.Column="5" Grid.RowSpan="2" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblRAMUsed" Text="-- GB" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- FAN CPU -->
                <StackPanel x:Name="panelCPUFan" Grid.Column="6" Grid.RowSpan="2" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                    <TextBlock Text="FAN" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblCPUFan" Text="-- RPM" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Placeholders para compatibilidad -->
        <Grid x:Name="FilaVRAM" Visibility="Collapsed"/>
        <Grid x:Name="FilaRAM" Visibility="Collapsed"/>

    </StackPanel>
</Window>
