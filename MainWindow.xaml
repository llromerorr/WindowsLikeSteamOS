<Window x:Class="SteamOSConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamOS Custom Shell Configurator" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#ADB5BD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9ECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0D6EFD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5ED7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Setter Property="Foreground" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="STEAMOS ENGINE" FontSize="24" FontWeight="Black" Foreground="#212529"/>
            <TextBlock Text="INTEGRACIÓN DE ENTORNO CRÍTICO AUTOMÁTICO" FontSize="9" Foreground="#6C757D" FontWeight="Bold"/>
            <Border Height="1" Background="#DEE2E6" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Label Content="PANTALLA DESTINO REQUERIDA"/>
            <ComboBox x:Name="cmbMonitores" SelectionChanged="CmbMonitores_SelectionChanged"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <Label Content="RESOLUCIÓN FORZADA"/>
                    <ComboBox x:Name="cmbResoluciones" SelectionChanged="CmbResoluciones_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="REFRESCO"/>
                    <ComboBox x:Name="cmbRefresco"/>
                </StackPanel>
            </Grid>

            <Label Content="DISPOSITIVO DE AUDIO EXCLUSIVO"/>
            <ComboBox x:Name="cmbAudio"/>

            <Border Background="#FFFFFF" CornerRadius="5" Padding="15" Margin="0,10,0,0" BorderBrush="#DEE2E6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="REQUISITOS DEL SISTEMA OPERATIVO" FontSize="10" FontWeight="Bold" Foreground="#6C757D" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="• Núcleo Launcher Steam: " Foreground="#212529" FontSize="13"/>
                        <TextBlock x:Name="lblEstadoSteam" Grid.Column="1" Text="Buscando..." FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="btnDesinstalar" Grid.Column="0" Content="DESINSTALAR" Style="{StaticResource DangerButton}" Click="BtnDesinstalar_Click"/>
            <Button x:Name="btnInstalar" Grid.Column="2" Content="INSTALAR ENTORNO" Style="{StaticResource PrimaryButton}" Click="BtnInstalar_Click"/>
        </Grid>
    </Grid>
</Window>