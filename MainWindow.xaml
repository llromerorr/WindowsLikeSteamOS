<ui:FluentWindow x:Class="SteamOSConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SteamOS" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SteamOS" Margin="0,0,0,0"/>

        <Grid Grid.Row="1" Margin="25, 15, 25, 25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="S T E A M O S" FontTypography="Title" FontWeight="Black" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <ui:TextBlock Text="  CONFIGURATOR" FontTypography="Title" FontWeight="Black" />
                </StackPanel>
                <ui:TextBlock Text="GAMING ENVIRONMENT &amp; PERFORMANCE CONTROL ENGINE" FontTypography="Caption" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="Bold" Margin="0,2,0,0"/>
                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,15,0,0"/>
            </StackPanel>

            <!-- CONTENEDOR DE VISTAS -->
            <Grid Grid.Row="1">
                
                <!-- VISTA SIMPLE -->
                <StackPanel x:Name="viewSimple" Visibility="Visible">
                    <Border CornerRadius="8" Padding="20" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,20">
                        <StackPanel>
                            <ui:TextBlock Text="ESTADO DEL SISTEMA" FontTypography="Caption" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,15"/>
                            
                            <!-- Steam -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotSteam" Width="10" Height="10" Fill="#FF4A4A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="lblSimpleSteam" Grid.Column="1" Text="Steam: Cargando..." FontTypography="BodyStrong" />
                            </Grid>
                            
                            <!-- Drivers -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotDrivers" Width="10" Height="10" Fill="#FF4A4A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="lblSimpleDrivers" Grid.Column="1" Text="Controladores Mando: Cargando..." FontTypography="BodyStrong" />
                            </Grid>

                            <!-- Mando -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotMando" Width="10" Height="10" Fill="#FF4A4A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="lblSimpleMando" Grid.Column="1" Text="Mando Virtual / Mapeo: Cargando..." FontTypography="BodyStrong" />
                            </Grid>

                            <!-- RTSS -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotRTSS" Width="10" Height="10" Fill="#FF4A4A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="lblSimpleRTSS" Grid.Column="1" Text="RivaTuner (RTSS): Cargando..." FontTypography="BodyStrong" />
                            </Grid>

                            <!-- MSI Afterburner -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotMSI" Width="10" Height="10" Fill="#FF4A4A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="lblSimpleMSI" Grid.Column="1" Text="MSI Afterburner: Cargando..." FontTypography="BodyStrong" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Panel de Progreso -->
                    <StackPanel x:Name="panelProgreso" Visibility="Collapsed" Margin="0,0,0,18">
                        <ui:TextBlock x:Name="lblProgreso" Text="Preparando descarga..." FontTypography="Caption" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                        <ui:ProgressRing x:Name="progresoBar" IsIndeterminate="True" />
                    </StackPanel>

                    <ui:Button x:Name="btnAccionPrincipal" Content="INSTALAR STEAMOS" Appearance="Primary" Height="50" HorizontalAlignment="Stretch" Click="BtnAccionPrincipal_Click"/>
                    
                    <ui:Button x:Name="btnDesinstalarSimple" Content="DESINSTALAR" Appearance="Danger" Height="30" Margin="0,10,0,0" Width="120" HorizontalAlignment="Center" Click="BtnDesinstalarSimple_Click"/>

                    <ui:Button x:Name="btnVerAvanzado" Appearance="Transparent" Margin="0,20,0,0" Click="BtnVerAvanzado_Click" HorizontalAlignment="Center" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Opciones Avanzadas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- VISTA AVANZADA -->
                <StackPanel x:Name="viewAvanzada" Visibility="Collapsed">
                    <ui:Button x:Name="btnVolverSimple" Appearance="Transparent" Margin="0,0,0,15" Click="BtnVolverSimple_Click" HorizontalAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Volver" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="HARDWARE VISUAL" FontTypography="Caption" FontWeight="Heavy" Margin="0,0,0,10"/>
                            
                            <Label Content="PANTALLA OBJETIVO" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                            <ComboBox x:Name="cmbMonitores" SelectionChanged="CmbMonitores_SelectionChanged" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="RESOLUCIÓN" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox x:Name="cmbResoluciones" IsEditable="True" SelectionChanged="CmbResoluciones_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="HERCIOS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                    <ComboBox x:Name="cmbRefresco" IsEditable="True"/>
                                </StackPanel>
                            </Grid>

                            <ui:TextBlock Text="OVERCLOCK &amp; RENDIMIENTO" FontTypography="Caption" FontWeight="Heavy" Margin="0,15,0,10"/>
                            
                            <Label Content="LÍMITE DE FPS (RIVA TUNER)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                            <ComboBox x:Name="cmbFPS" IsEditable="True" Margin="0,0,0,12">
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="40"/>
                                <ComboBoxItem Content="45"/>
                                <ComboBoxItem Content="60"/>
                                <ComboBoxItem Content="120"/>
                                <ComboBoxItem Content="0"/>
                            </ComboBox>

                            <CheckBox x:Name="chkFastSync" Content="Forzar NVIDIA Fast Sync (0 Latencia)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ui:TextBlock Text="AUDIO &amp; CONTROLADORES" FontTypography="Caption" FontWeight="Heavy" Margin="0,0,0,10"/>
                            
                            <Label Content="ENRUTAMIENTO DE AUDIO" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                            <ComboBox x:Name="cmbAudio" Margin="0,0,0,12"/>

                            <Label Content="DELAY BOTÓN HOME (SELECT+START)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ui:TextBox x:Name="txtDelayHome" Text="65" MaxLength="4" />
                                
                                <ui:TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                            </Grid>

                            <CheckBox x:Name="chkEmulador" Content="Activar Traductor de Mando" IsChecked="True" Margin="0,0,0,12"/>
                            <CheckBox x:Name="chkAutoLogon" Content="Auto-Login (Arrancar directo a SteamOS al encender el PC)" IsChecked="True" Margin="0,0,0,12"/>
                            
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,5,0,0">
                                <StackPanel>
                                    <ui:TextBlock x:Name="lblNombreMando" Text="Ningún mando mapeado" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                    <ui:Button x:Name="btnConfigurarMando" Content="MAPEAR MANDO" Appearance="Secondary" HorizontalAlignment="Stretch" Height="30" Click="BtnConfigurarMando_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="8" Padding="15" Margin="0,20,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <ui:TextBlock Text="D I A G N Ó S T I C O   D E L   N Ú C L E O" FontTypography="Caption" FontWeight="Black" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:TextBlock Text="Steam Shell:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" FontWeight="SemiBold"/>
                                <ui:TextBlock x:Name="lblEstadoSteam" Grid.Column="1" Text="..." FontTypography="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:TextBlock Text="ViGEm + HidHide:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" FontWeight="SemiBold"/>
                                <ui:TextBlock x:Name="lblEstadoDrivers" Grid.Column="1" Text="..." FontTypography="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:TextBlock Text="RivaTuner (RTSS):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" FontWeight="SemiBold"/>
                                <ui:TextBlock x:Name="lblEstadoRTSS" Grid.Column="1" Text="..." FontTypography="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:TextBlock Text="MSI Afterburner:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" FontWeight="SemiBold"/>
                                <ui:TextBlock x:Name="lblEstadoMSI" Grid.Column="1" Text="..." FontTypography="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Botones avanzados de Deploy/Desinstalar -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnDesinstalar" Grid.Column="0" Content="PURGAR" Appearance="Danger" HorizontalAlignment="Stretch" Click="BtnDesinstalar_Click"/>
                        <ui:Button x:Name="btnInstalar" Grid.Column="2" Content="APLICAR Y DEPLOYAR" Appearance="Primary" HorizontalAlignment="Stretch" Click="BtnInstalar_Click"/>
                    </Grid>
                </StackPanel>
                
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
