<Window x:Class="SteamOSConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurador - Modo Consola" Height="620" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" FontFamily="Segoe UI" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEEEEE"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="Foreground" Value="#107C10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F2E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#D13438"/>
            <Setter Property="Foreground" Value="#D13438"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FCECEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="STEAM OS" FontSize="24" FontWeight="Light"/>
            <TextBlock Text="CONFIGURADOR DE ENTORNO" FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
            <Border Height="1" Background="#E0E0E0" Margin="0,15,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="PANTALLA DESTINO" FontSize="12" Foreground="#555555" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbMonitores" Height="30" Margin="0,0,0,15" Padding="5" SelectionChanged="CmbMonitores_SelectionChanged"/>

            <TextBlock Text="RESOLUCIÓN NATIVA Y REFRESCO" FontSize="12" Foreground="#555555" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbResoluciones" Grid.Column="0" Height="30" Padding="5" SelectionChanged="CmbResoluciones_SelectionChanged"/>
                <ComboBox x:Name="cmbRefresco" Grid.Column="2" Height="30" Padding="5"/>
            </Grid>

            <TextBlock Text="SALIDA DE AUDIO" FontSize="12" Foreground="#555555" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbAudio" Height="30" Margin="0,0,0,20" Padding="5"/>

            <TextBlock Text="REQUISITOS DEL SISTEMA" FontSize="12" Foreground="#555555" Margin="0,10,0,5"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="• Cliente de Steam:" Foreground="#888888"/>
                <TextBlock x:Name="lblEstadoSteam" Grid.Column="1" Text="Buscando..." FontWeight="SemiBold"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="• Mando (ViGEmBus):" Foreground="#888888" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblEstadoDriver" Grid.Column="1" Text="Buscando..." VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="Mapear Mando" Width="100" Height="25" FontSize="11" Click="BtnMapear_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Height="1" Background="#E0E0E0" Margin="0,0,0,20"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnDesinstalar" Grid.Column="0" Content="DESINSTALAR" Height="40" Style="{StaticResource BotonPeligro}" Click="BtnDesinstalar_Click"/>
                <Button x:Name="btnInstalar" Grid.Column="2" Content="INSTALAR" Height="40" Style="{StaticResource BotonPrimario}" Click="BtnInstalar_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>